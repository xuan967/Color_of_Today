        }
        // è·¯å¾„äºŒå…œåº•ï¼šsurfaceId ç›´æŽ¥åˆ›å»º NativeWindowï¼ˆå®˜æ–¹æŽ¨èè·¯å¾„ï¼Œéƒ¨åˆ†è®¾å¤‡å›žè°ƒæ³¨å…¥å¼‚å¸¸æ—¶å¯ç”¨ï¼‰
        if (!ready) {
            const sid = await this.xcController.getXComponentSurfaceId();
            ready = colorFilter.initFromSurfaceId(Number(sid));
            for (let i = 0; i < 15 && !ready; i++) {
                await this.sleep(200);
                ready = colorFilter.isRendererReady();
            }
        }
        if (!ready) {
            this.camError = 'æ¸²æŸ“ç®¡çº¿åˆå§‹åŒ–å¤±è´¥';
            this.starting = false;
            return;
