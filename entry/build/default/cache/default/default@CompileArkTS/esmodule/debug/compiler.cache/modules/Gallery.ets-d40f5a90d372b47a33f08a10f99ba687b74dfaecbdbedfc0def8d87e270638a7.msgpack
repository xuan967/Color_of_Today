            .fontColor('#1A1A1A')
          Blank()
          // å²æœˆè‰²å¡å…¥å£ï¼ˆéšè”½è€Œä¼˜é›…ï¼‰
          Row({ space: 4 }) {
            Column()
              .width(10)
              .height(10)
              .borderRadius(3)
              .backgroundColor(this.today.hex)
              .opacity(0.85)
            Text('å²æœˆè‰²å¡')
              .fontSize(12)
              .fontColor('#616161')
          }
          .padding({ left: 10, right: 10, top: 6, bottom: 6 })
          .backgroundColor('#F0F0F2')
          .borderRadius(14)
          .onClick(() => {
            router.pushUrl({ url: 'pages/TimePalette' });
          })
          Text(`${this.photos.length} å¼ `)
            .fontSize(13)
            .fontColor('#9E9E9E')
        }
        .width('100%')
        .height(56)
        .padding({ left: 12, right: 16 })

        Divider().strokeWidth(0.5).color('#EEEEEE')

        if (this.photos.length === 0) {
          Column({ space: 12 }) {
            Column()
              .width(64)
              .height(64)
              .borderRadius(32)
              .backgroundColor(this.today.hex)
              .opacity(0.25)
            Text('ä»Šå¤©è¿˜æ²¡æœ‰ç…§ç‰‡')
              .fontSize(15)
              .fontColor('#757575')
            Text('å›åˆ°å–æ™¯é¡µï¼Œæ‹ä¸‹å±äºä»Šå¤©çš„é¢œè‰²å§')
              .fontSize(13)
              .fontColor('#BDBDBD')
          }
          .width('100%')
          .layoutWeight(1)
          .justifyContent(FlexAlign.Center)
        } else {
          Grid() {
            ForEach(this.photos, (photo: PhotoInfo) => {
              GridItem() {
                Image(`file://${photo.localPath}`)
                  .width('100%')
                  .aspectRatio(0.72)
                  .objectFit(ImageFit.Cover)
                  .borderRadius(14)
                  .onClick(() => {
                    this.viewing = photo;
                  })
              }
            }, (photo: PhotoInfo) => `${photo.id}`)
          }
          .columnsTemplate('1fr 1fr')
          .columnsGap(10)
          .rowsGap(10)
          .padding(14)
          .scrollBar(BarState.Off)
          .layoutWeight(1)
        }
      }
      .width('100%')
      .height('100%')
      .backgroundColor('#FAFAFA')

      // å…¨å±æŸ¥çœ‹
      if (this.viewing !== null) {
        Stack() {
          Image(`file://${this.viewing.localPath}`)
            .width('100%')
            .height('100%')
            .objectFit(ImageFit.Contain)

          Row() {
            Text('â€¹')
              .fontSize(26)
              .fontColor(Color.White)
              .width(40)
              .height(40)
              .textAlign(TextAlign.Center)
              .backgroundColor('rgba(0,0,0,0.35)')
              .borderRadius(20)
              .onClick(() => {
                this.viewing = null;
              })
            Blank()
            Text('åˆ é™¤')
              .fontSize(14)
              .fontColor(Color.White)
              .height(40)
              .padding({ left: 18, right: 18 })
              .textAlign(TextAlign.Center)
              .backgroundColor('rgba(0,0,0,0.35)')
              .borderRadius(20)
              .onClick(() => {
                this.deleteCurrent();
              })
          }
          .width('100%')
          .padding({ left: 18, right: 18, bottom: 46 })
          .position({ x: 0, y: '100%' })
          .translate({ y: '-100%' })

          Column({ space: 2 }) {
            Text(`${this.viewing.colorName} Â· ${this.viewing.colorHex}`)
              .fontSize(14)
              .fontColor(Color.White)
              .shadow({ radius: 8, color: 'rgba(0,0,0,0.6)' })
          }
          .width('100%')
          .padding({ top: 60 })
          .hitTestBehavior(HitTestMode.None)
        }
        .width('100%')
        .height('100%')
        .backgroundColor(Color.Black)
      }
    }
    .width('100%')
    .height('100%')
  }
}
