                days.push({ day: cells[i].day, hex: cells[i].hex });
            }
            this.exportPm = await renderPaletteCard(this.monthLabel(), days, 'æ¯ä¸€å¤©ï¼Œéƒ½æœ‰å®ƒçš„é¢œè‰²ã€‚');
            this.exportShow = true;
