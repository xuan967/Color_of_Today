            fs.writeSync(file.fd, data);
            fs.closeSync(file.fd);
            const uri = await CaptureService.saveToAlbum(context, path);
            if (uri !== null) {
                promptAction.showToast({ message: 'è‰²å¡å·²ä¿å­˜åˆ°ç³»ç»Ÿç›¸å†Œ' });
            }
            else {
                promptAction.showToast({ message: 'ä¿å­˜åˆ°ç›¸å†Œå¤±è´¥' });
            }
        }
        catch (err) {
            promptAction.showToast({ message: 'ä¿å­˜å¤±è´¥' });
        }
