        for (let day = 1; day <= total; day++) {
            const d = this.monthDate();
            const key = `${d.getFullYear()}${`${d.getMonth() + 1}`.padStart(2, '0')}${`${day}`.padStart(2, '0')}`;
            const hex = this.dayColorMap.get(key);
            cells.push({ day: day, key: key, hex: hex ?? '' });
