/** ç…§ç‰‡å…ƒæ•°æ®ï¼ˆRDB è¡¨ photos çš„ä¸€è¡Œï¼‰ */
export interface PhotoInfo {
  id: number;         // è‡ªå¢ä¸»é”®
  uri: string;        // ç³»ç»Ÿç›¸å†Œä¸­çš„ photoAccessHelper uriï¼ˆåˆ†äº«ã€è·³ç³»ç»Ÿç›¸å†Œç”¨ï¼‰
  localPath: string;  // åº”ç”¨æ²™ç®±å†…å‰¯æœ¬è·¯å¾„ï¼ˆç›¸å†Œé¡µ/ç¼©ç•¥å›¾å±•ç¤ºç”¨ï¼Œå…åª’ä½“è¯»æƒé™ï¼‰
  dateKey: string;    // æ‹æ‘„æ—¥æœŸé”® YYYYMMDDï¼Œâ€œä»Šæ—¥ç›¸å†Œâ€æŒ‰æ­¤æŸ¥è¯¢
  colorName: string;  // æ‹æ‘„å½“æ—¥çš„é¢œè‰²åï¼ˆå¦‚â€œå…‹è±å› è“â€ï¼‰
  colorHex: string;   // æ‹æ‘„å½“æ—¥çš„é¢œè‰² HEXï¼ˆç›¸å†Œé¡µè‰²å¡å¤ç°ï¼‰
