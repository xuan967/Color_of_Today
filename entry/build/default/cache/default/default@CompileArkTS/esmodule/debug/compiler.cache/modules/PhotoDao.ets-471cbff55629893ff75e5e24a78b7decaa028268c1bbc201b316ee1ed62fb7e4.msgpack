        }
        await this.store.executeSql('INSERT OR REPLACE INTO color_unlocks (name, hex, first_date_key, count, updated_at) VALUES (?, ?, ?, 1, ?)', [name, hex, dateKey, Date.now()]);
    }
    async increaseColorUnlock(name) {
        if (this.store === null) {
            return;
        }
        await this.store.executeSql('UPDATE color_unlocks SET count = count + 1, updated_at = ? WHERE name = ?', [Date.now(), name]);
    }
    /** å·²è§£é”ä¼ ç»Ÿè‰² â†’ ç›¸é‡æ¬¡æ•° */
    async queryColorUnlockCounts() {
        const map = new Map();
        if (this.store === null) {
            return map;
        }
        const predicates = new relationalStore.RdbPredicates('color_unlocks');
        const resultSet = await this.store.query(predicates, ['name', 'count']);
        try {
            while (resultSet.goToNextRow()) {
                map.set(resultSet.getString(resultSet.getColumnIndex('name')), resultSet.getLong(resultSet.getColumnIndex('count')));
            }
        }
        finally {
            resultSet.close();
        }
        return map;
    }
    /** å•ä¸ªä¼ ç»Ÿè‰²çš„è§£é”è®°å½•ï¼ˆnull=æœªè§£é”ï¼‰ */
    async getColorUnlock(name) {
        if (this.store === null) {
            return null;
        }
        const predicates = new relationalStore.RdbPredicates('color_unlocks');
        predicates.equalTo('name', name);
        const resultSet = await this.store.query(predicates, ['name']);
        let found = null;
        try {
            if (resultSet.goToNextRow()) {
                found = true;
            }
        }
        finally {
            resultSet.close();
        }
        return found;
    }
    /** ===== æ—¶ç©ºå›å£°ç»Ÿè®¡ ===== */
    /** æŸå¤©çš„ç…§ç‰‡æ•° */
    async countPhotosOn(dateKey) {
        if (this.store === null) {
            return 0;
        }
        const predicates = new relationalStore.RdbPredicates(TABLE_PHOTOS);
        predicates.equalTo('date_key', dateKey);
        const resultSet = await this.store.query(predicates, ['id']);
        const count = resultSet.rowCount;
        resultSet.close();
        return count;
    }
    /** æŸå¤©ç¬¬ä¸€å¼ ç…§ç‰‡çš„é¢œè‰²åï¼ˆå»å¹´çš„ä»Šå¤©å›å£°ç”¨ï¼‰ */
    async firstColorNameOn(dateKey) {
        if (this.store === null) {
            return null;
        }
        const predicates = new relationalStore.RdbPredicates(TABLE_PHOTOS);
        predicates.equalTo('date_key', dateKey).orderByAsc('created_at').limitAs(1);
        const resultSet = await this.store.query(predicates, ['color_name']);
        let name = null;
        try {
            if (resultSet.goToNextRow()) {
                name = resultSet.getString(resultSet.getColumnIndex('color_name'));
            }
        }
        finally {
            resultSet.close();
        }
        return name;
    }
    /** ä»Šå¹´é‡è§æŸè‰²çš„æ¬¡æ•° */
    async countPhotosByColorNameYear(colorName, yearPrefix) {
        if (this.store === null) {
            return 0;
        }
        const predicates = new relationalStore.RdbPredicates(TABLE_PHOTOS);
        predicates.equalTo('color_name', colorName)
            .beginsWith('date_key', yearPrefix);
        const resultSet = await this.store.query(predicates, ['id']);
        const count = resultSet.rowCount;
        resultSet.close();
        return count;
    }
    /** ç”¨é¢œè‰²è®°å½•ç”Ÿæ´»çš„å¤©æ•°ï¼ˆå»é‡æ—¥æœŸï¼‰ */
    async countDistinctDays() {
        if (this.store === null) {
