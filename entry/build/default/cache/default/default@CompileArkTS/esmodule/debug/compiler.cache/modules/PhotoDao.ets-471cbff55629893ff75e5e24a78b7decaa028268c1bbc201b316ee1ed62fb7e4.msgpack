        }
        const resultSet = await this.store.querySql('SELECT COUNT(DISTINCT date_key) AS cnt FROM photos');
        let count = 0;
        try {
            if (resultSet.goToFirstRow()) {
                count = resultSet.getLong(resultSet.getColumnIndex('cnt'));
            }
        }
        finally {
            resultSet.close();
        }
        return count;
    }
    /** ç´¯è®¡ç…§ç‰‡æ•° */
    async countAll() {
