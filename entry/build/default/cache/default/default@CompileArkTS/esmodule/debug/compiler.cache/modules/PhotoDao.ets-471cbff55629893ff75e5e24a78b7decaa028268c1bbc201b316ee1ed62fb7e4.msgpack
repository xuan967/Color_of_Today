    async saveDayColor(dateKey, hex) {
        if (this.store === null) {
            return;
        }
        await this.store.executeSql('INSERT OR REPLACE INTO day_colors (date_key, hex, updated_at) VALUES (?, ?, ?)', [dateKey, hex, Date.now()]);
    }
    /** åŒºé—´å†…çš„å·²ç¼“å­˜æ—¥ä¸»è‰² */
    async queryDayColors(startKey, endKey) {
        const map = new Map();
        if (this.store === null) {
            return map;
        }
        const predicates = new relationalStore.RdbPredicates('day_colors');
        predicates.between('date_key', startKey, endKey);
        const resultSet = await this.store.query(predicates, ['date_key', 'hex']);
        try {
            while (resultSet.goToNextRow()) {
                map.set(resultSet.getString(resultSet.getColumnIndex('date_key')), resultSet.getString(resultSet.getColumnIndex('hex')));
            }
        }
        finally {
            resultSet.close();
        }
        return map;
    }
    /** åŒºé—´å†…çš„å…¨éƒ¨ç…§ç‰‡ï¼ˆæŒ‰æ—¶é—´å‡åºï¼‰ï¼Œä¾›æŒ‰å¤©åˆ†ç»„æå–ä¸»è‰² */
    async queryPhotosBetween(startKey, endKey) {
        if (this.store === null) {
            return [];
        }
        const predicates = new relationalStore.RdbPredicates(TABLE_PHOTOS);
        predicates.between('date_key', startKey, endKey).orderByAsc('created_at');
        const resultSet = await this.store.query(predicates, COLUMNS);
